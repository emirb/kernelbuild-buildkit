# The minimum a microVM guest needs on top of the kbuild defaults: load an
# initramfs, print to the serial console, and exec a static /init. An empty
# config resolves to none of these (measured: olddefconfig leaves
# BLK_DEV_INITRD and SERIAL_8250 off), so a "defaults" kernel builds and
# links but boots to silence.
#
# This is deliberately the floor, not a guest config. For a real guest start
# from Firecracker's or Cloud Hypervisor's curated configs (see the README).
CONFIG_BLK_DEV_INITRD=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_TTY=y
CONFIG_PRINTK=y
CONFIG_BINFMT_ELF=y
# Firecracker and Cloud Hypervisor enter the uncompressed vmlinux through the
# PVH boot ABI.
CONFIG_PVH=y
# Paravirt clock: a microVM has no PIT or HPET, so without this the kernel
# cannot calibrate the TSC and hangs before init (measured under QEMU's
# microvm machine).
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
